# Application Server Configuration
PORT=8080
APP_ENV=development

# Database URL for PostgreSQL (e.g., Neon or local)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Goose Migration Settings
GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
GOOSE_MIGRATION_DIR=internal/db/migrations

# JWT & Authentication
JWT_SECRET=afriops-super-secret-jwt-key-2026-very-secure
JWT_EXPIRY_HOURS=24
COOKIE_NAME=access_token
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Document Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=25

# AI & RAG Configuration (openai | gemini)
AI_PROVIDER=openai

# OpenAI Settings
OPENAI_API_KEY=sk-placeholder-set-your-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Gemini Settings (used if AI_PROVIDER=gemini)
GEMINI_API_KEY=AIza-placeholder-set-your-key-here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

