# Application Server Configuration
PORT=8080
APP_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=runtir_db
DB_SSLMODE=disable

# Database URL for pgx
DATABASE_URL=postgres://postgres:postgres@localhost:5432/runtir_db?sslmode=disable

# Goose Migration Settings
GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgres://postgres:postgres@localhost:5432/runtir_db?sslmode=disable
GOOSE_MIGRATION_DIR=internal/db/migrations

# JWT & Authentication
JWT_SECRET=afriops-super-secret-jwt-key-2026-very-secure
JWT_EXPIRY_HOURS=24
COOKIE_NAME=access_token
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Document Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=25
